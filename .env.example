APP_ENV=development
DATABASE_URL=postgresql+psycopg://ufabc:ufabc@db:5432/ufabc_ranking
IMPORT_STORAGE_PATH=/app/var/imports
LOG_LEVEL=INFO
UFABC_NEXT_ENABLED=true
UFABC_NEXT_BASE_URL=https://api.v2.ufabcnext.com
UFABC_NEXT_TIMEOUT_SECONDS=15
UFABC_NEXT_MAX_RETRIES=2
UFABC_NEXT_BACKOFF_SECONDS=0.5
UFABC_NEXT_MIN_INTERVAL_SECONDS=1.0
UFABC_NEXT_MAX_REQUESTS_PER_SYNC=50
UFABC_NEXT_COMPONENT_CACHE_SECONDS=900
UFABC_NEXT_REVIEW_CACHE_SECONDS=86400
POSTGRES_DB=ufabc_ranking
POSTGRES_USER=ufabc
POSTGRES_PASSWORD=ufabc
